{
    "name": "prestashopheaven/mono-runtime-core",
    "description": "The core every PrestaHaven module uses: module lifecycle (install, uninstall, migrations, upgrades, tabs, configuration page), the command bus, the shared value objects and multistore. No external dependencies (D21).",
    "version": "1.0.0",
    "type": "project",
    "license": "MIT",
    "repositories": [
        {
            "type": "path",
            "url": "packages/*",
            "options": {
                "symlink": true,
                "versions": {
                    "prestashopheaven/runtime-cqrs": "1.0.0",
                    "prestashopheaven/runtime-kit": "1.0.0",
                    "prestashopheaven/runtime-multistore": "1.0.0",
                    "prestashopheaven/runtime-shared-kernel": "1.0.0"
                }
            }
        }
    ],
    "require": {
        "php": ">=8.1",
        "prestashopheaven/runtime-cqrs": "*",
        "prestashopheaven/runtime-kit": "*",
        "prestashopheaven/runtime-multistore": "*",
        "prestashopheaven/runtime-shared-kernel": "*"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.2",
        "phpcompatibility/php-compatibility": "^10.0@alpha",
        "phpunit/phpunit": "^10.5",
        "prestashopheaven/build-tools": "^1.0",
        "psr/container": "^1.1 || ^2.0"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "platform": {
            "php": "8.1.0"
        },
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "extra": {
        "prestashopheaven": {
            "monorepo": {
                "kind": "runtime",
                "category": "core"
            }
        }
    },
    "scripts": {
        "check": "ps-module mono check"
    }
}
