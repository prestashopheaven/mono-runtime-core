{
    "name": "prestashopheaven/heavenmonocore",
    "description": "Fixture module of mono-runtime-core: runs the integration tests of the core packages in real shops. Never released.",
    "type": "prestashop-module",
    "license": "MIT",
    "repositories": [
        {
            "type": "path",
            "url": "../../../packages/*",
            "options": {
                "symlink": false,
                "versions": {
                    "prestashopheaven/runtime-cqrs": "1.0.0",
                    "prestashopheaven/runtime-kit": "1.0.0",
                    "prestashopheaven/runtime-multistore": "1.0.0",
                    "prestashopheaven/runtime-shared-kernel": "1.0.0"
                }
            }
        }
    ],
    "require": {
        "php": ">=8.1",
        "prestashopheaven/runtime-cqrs": "1.0.0",
        "prestashopheaven/runtime-kit": "1.0.0",
        "prestashopheaven/runtime-multistore": "1.0.0",
        "prestashopheaven/runtime-shared-kernel": "1.0.0"
    },
    "require-dev": {
        "prestashopheaven/build-tools": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "PrestaShopHeaven\\MonoCore\\Fixture\\": "src/"
        },
        "classmap": [
            "heavenmonocore.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "PrestaShopHeaven\\MonoCore\\Fixture\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.1.0"
        },
        "sort-packages": true,
        "prepend-autoloader": false
    },
    "extra": {
        "prestashopheaven": {
            "scope-prefix": "PrestaShopHeaven\\MonoCore\\Fixture\\Vendor",
            "scope": [
                "PrestaShopHeaven\\Runtime"
            ]
        }
    },
    "scripts": {
        "post-install-cmd": [
            "ps-module mono fixture-tests"
        ],
        "post-update-cmd": [
            "ps-module mono fixture-tests"
        ]
    }
}
